# ============================================================
#  Chatizy E2EE — Environment Variables Template
#  Copy to .env.local (web) or configure per-platform
# ============================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# --- Cloudflare R2 (Part 4) ---
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID_HERE
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID_HERE
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY_HERE
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME_HERE
R2_PUBLIC_URL=YOUR_R2_PUBLIC_URL_HERE

# --- Push Notifications (Part 4) ---
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY_HERE
APNS_KEY_ID=YOUR_APNS_KEY_ID_HERE
APNS_TEAM_ID=YOUR_APNS_TEAM_ID_HERE
